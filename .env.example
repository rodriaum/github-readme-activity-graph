# Optional GitHub personal access token for the default activity fetcher
TOKEN=<GitHub access token>

# GitHub OAuth App settings (required for optional private contribution access)
GITHUB_OAUTH_CLIENT_ID=<GitHub OAuth App client ID>
GITHUB_OAUTH_CLIENT_SECRET=<GitHub OAuth App client secret>

# Public base URL of this deployment, without a trailing slash
APP_URL=https://your-deployment-domain.example

# Use separate random secrets of at least 32 characters
OAUTH_COOKIE_SECRET=<random secret with at least 32 characters>
PRIVATE_SHARE_SECRET=<different random secret with at least 32 characters>
